# Known vulnerabilities in libraries bundled inside the P2Rank release itself.
# They cannot be fixed here — packaging only unpacks the upstream tarball — so
# they are acknowledged rather than left to redden every build. New findings
# still fail CI.
#
# Fix upstream by bumping the dependency in rdk/p2rank, then delete the entry.
# The expiry dates force a re-review rather than letting these rot silently.

# jackson-core 2.13.4 -> 2.15.0+ (StackOverflowError on deep input)
CVE-2025-52999 exp:2027-01-01
# jackson-core 2.13.4 -> 2.18.8+ (async parser maxNumberLength bypass)
GHSA-r7wm-3cxj-wff9 exp:2027-01-01
# jackson-databind 2.13.4.2 -> 2.18.8+ (PolymorphicTypeValidator bypass, RCE)
CVE-2026-54512 exp:2027-01-01
CVE-2026-54513 exp:2027-01-01
# msgpack-core 0.8.24 -> 0.9.11+ (denial of service)
CVE-2026-21452 exp:2027-01-01
